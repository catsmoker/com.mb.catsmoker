    <string name="gf_adv_restricted_t">Allow restricted cvars</string>
    <string name="gf_adv_restricted_c">Off strips the cvars the game\'s integrity checks watch (view distance, detail mode, screen percentage, streaming pool…). Safer, weaker.</string>
