    <string name="gf_files_scal_c">The per-level sg.* tables the game\'s own quality menu reads.</string>
    <string name="gf_files_hw_t">Generate Hardware.ini</string>
    <string name="gf_files_hw_c">Device profile name, frame pace and aniso/LOD for the hardware layer.</string>
    <string name="gf_files_always">Engine.ini, DeviceProfiles.ini and GameUserSettings.ini are always generated.</string>
