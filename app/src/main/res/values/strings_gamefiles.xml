    <string name="gf_wuwa_vsync_t">VSync</string>
    <string name="gf_wuwa_vsync_c">Keeps the frame pace aligned with the display; off can tear but saves latency.</string>
    <string name="gf_game_mode">GAME MODE</string>
    <string name="gf_mode_overworld">Overworld</string>
    <string name="gf_mode_toa">Tower of Adversity</string>
    <string name="gf_wuwa_mode_body">Tower of Adversity lightens the open-world environment (fog, foliage, SSR off) but keeps character quality — the arena is a closed box, so there is less to render and no reason to cut what is on screen.</string>
    <string name="gf_effects">EFFECTS</string>
    <string name="gf_fx_outline_t">Character outline</string>
    <string name="gf_fx_outline_c">Toon outline around characters.</string>
    <string name="gf_fx_radial_t">Radial blur</string>
    <string name="gf_fx_radial_c">Speed lines and hit effects.</string>
    <string name="gf_fx_bloom_t">Bloom</string>
    <string name="gf_fx_bloom_c">Glow around bright surfaces.</string>
    <string name="gf_fx_exposure_t">Auto exposure</string>
    <string name="gf_fx_exposure_c">Scene brightness adaptation.</string>
    <string name="gf_fx_ssr_t">Screen-space reflections</string>
    <string name="gf_fx_ssr_c">Water and scene reflections. High-end GPUs only.</string>
    <string name="gf_fx_ca_t">Chromatic aberration</string>
    <string name="gf_fx_ca_c">Color fringing at screen edges.</string>
    <string name="gf_fx_hzb_t">HZB occlusion</string>
    <string name="gf_fx_hzb_c">Skips rendering objects hidden behind others.</string>
    <string name="gf_fx_cool_t">Auto cool-down</string>
    <string name="gf_fx_cool_c">The game\'s own thermal safeguard — lowers quality when hot.</string>
    <string name="gf_fx_vulkan_t">Force Vulkan renderer</string>
    <string name="gf_fx_vulkan_c">Off unless the device\'s GLES driver is the problem — asserted by you, not auto-set; the GAME LOG card tells you which API the game actually ran last session.</string>
    <string name="gf_fx_noauto_t">Disable auto quality adjustment</string>
    <string name="gf_fx_noauto_c">Locks quality where the preset puts it and pins t.MaxFPS to the frame rate above instead.</string>
