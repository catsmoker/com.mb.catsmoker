<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="ru.zdevs.zarchiver" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <!--
            The games whose install state the File Engineering screen probes with
            PackageManager.getPackageInfo. The blanket MAIN/GAME intent below made them
            visible in practice, but visibility by intent-match is implicit; a stricter
            OEM filter would turn a real install into a silent NameNotFoundException and
            a false "not installed" dot. Naming the packages makes the probe's world
            explicit: Genshin + five PUBG variants, GRID, WuWa, five HSR variants.
        -->
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.vng.pubgmobile" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.rekoo.pubgm" />
        <package android:name="com.feralinteractive.gridas" />
        <package android:name="com.kurogame.wutheringwaves.global" />
        <package android:name="com.HoYoverse.hkrpgoversea" />
        <package android:name="com.miHoYo.hkrpg" />
        <package android:name="com.HoYoverse.hkrpg" />
        <package android:name="com.cognosphere.hkrpg" />
        <package android:name="com.HoYoverse.hkrpgsamsung" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.GAME" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.AD_ID" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="AllFilesAccessPolicy" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!--
        Never granted at install: it is signature|privileged. It is declared so that the adb grant
        `pm grant com.catsmoker.app android.permission.WRITE_SECURE_SETTINGS` can actually take effect —
        without the declaration that command fails, and the animation-scale and Private DNS cards would
        offer a channel the app could never hold. Root and Shizuku remain the normal paths.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Needed by the overlay boot receiver: without the declaration, BOOT_COMPLETED is never delivered. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name="com.catsmoker.app.system.CatsmokerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Catsmoker">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Unlock max FPS and optimize supported games." />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />
        <meta-data android:name="xposedscope" android:resource="@array/scope" />
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />

        <activity
            android:name=".system.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exported because the Xposed hooks read it from inside the target app's process, under
            that app's UID. The provider only ever serves a caller its own profile, so being
            exported does not let an app enumerate the user's spoof assignments.
        -->
        <provider
            android:name=".system.config.SpoofConfigProvider"
            android:authorities="com.catsmoker.app.configprovider"
            android:exported="true" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
            WorkManager on demand: the default initializer is removed so the HiltWorkerFactory in
            CatsmokerApp constructs @HiltWorker workers. With both present, WorkManager would
            initialize with the default (no-)factory and DexoptSweepWorker would fail to be created.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            WorkManager's own foreground service, re-declared so a worker's setForeground() can run
            as specialUse — the same type and subtype property every other long-running service in
            this app uses. Without the type, a setForeground on Android 14+ throws.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="specialUse"
            tools:node="merge">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Scheduled dexopt sweep" />
        </service>

        <!-- Disable StartApp SDK Auto-Initialization -->
        <provider
            android:name="com.startapp.sdk.adsbase.StartAppInitProvider"
            android:authorities="${applicationId}.startappinitprovider"
            tools:node="remove" />

        <service
            android:name=".features.gamingtools.tools.crosshair.CrosshairOverlayService"
            android:exported="false"
            android:enabled="true"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Crosshair" />
        </service>

        <service
            android:name=".features.gamingtools.tools.overlay.PerformanceOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Performance Overlay" />
        </service>

        <!--
            Restarts the performance overlay after a reboot or an app update, but only when the
            user had it running — the decision comes from a persisted flag the service itself
            writes, not from in-process state that resets on every boot.
        -->
        <receiver
            android:name=".features.gamingtools.tools.overlay.OverlayBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".features.gamingtools.tools.booster.AppBoosterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Booster" />
        </service>

        <!--
            The Stop action on the scheduled dexopt sweep's notification. It cancels the sweep the
            engine is running, not the schedule itself — cancelling the unique work name would take
            the recurring schedule down with the run, which is not what a Stop button promises.
        -->
        <receiver
            android:name=".features.gamingtools.tools.booster.DexoptSweepStopReceiver"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".features.gamingtools.tools.forcestop.AutoForceStopService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Silent Hunter" />
        </service>

        <service
            android:name=".features.gamingtools.engine.GamingModeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Gaming Mode" />
        </service>

        <!--
            Second-layer notification suppression while Gaming Mode is on. BIND_NOTIFICATION_
            LISTENER_SERVICE is enforced by the system, so it is declared on the service rather
            than requested at install: only Android itself may bind here, and only after the
            user grants notification access in Settings. Until that grant this service is inert
            and Gaming Mode reports the layer as not applicable.
        -->
        <service
            android:name=".features.gamingtools.engine.GamingNotificationListener"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            The local VPN that blocks other apps' network access. BIND_VPN_SERVICE is enforced by the
            system, so it is declared on the service rather than requested at install: only Android
            itself may bind here. The user still has to accept Android's own VPN consent dialog before
            the interface can be established.
        -->
        <service
            android:name=".features.gamingtools.tools.firewall.VpnFirewallService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="App network block" />
        </service>

    </application>
</manifest>
